PORT=3000
# Database: used by docker-compose.yml to create it and by the server to connect.
POSTGRES_USER=kuzix
POSTGRES_PASSWORD=kuzix
POSTGRES_DB=kuzix
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: a full connection URL overrides the POSTGRES_* values above.
# DATABASE_URL=postgres://kuzix:kuzix@localhost:5432/kuzix
JWT_SECRET=change-me
FRONT_URL=http://localhost:5173
# Public URL the OAuth providers redirect to (through the Vite proxy in dev)
SERVER_URL=http://localhost:5173
# Optional email confirmation for password sign-ups. Leave SMTP_HOST empty to skip it (sign-up logs in at once).
# Port 465 uses TLS, other ports STARTTLS. SMTP_FROM defaults to SMTP_USER; a bare address is sent as "Kuzix <address>".
# For inbox placement, send from a domain with SPF, DKIM and DMARC set up for your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
