{
	"name": "kuzix",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "npm run dev:server & npm run dev:front",
		"dev:server": "tsx watch server/src/index.ts",
		"dev:front": "vite --config front/vite.config.ts",
		"build": "vite build --config front/vite.config.ts",
		"start": "NODE_ENV=production tsx server/src/index.ts",
		"typecheck": "tsc -p server/tsconfig.json && vue-tsc -p front/tsconfig.json",
		"test": "node --import tsx --test 'server/src/**/*.test.ts'",
		"lint": "eslint front/src server/src front/vite.config.ts eslint.config.js",
		"lint:fix": "eslint --fix front/src server/src front/vite.config.ts eslint.config.js"
	},
	"dependencies": {
		"express": "^5.3.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.23.1",
		"qrcode": "^1.5.4",
		"tsx": "^4.23.15",
		"vue": "^3.5.45",
		"vue-router": "^5.4.0",
		"ws": "^8.22.2"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"@types/ws": "^8.18.2",
		"@vitejs/plugin-vue": "^6.0.10",
		"eslint": "^10.14.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.7",
		"vue-eslint-parser": "^10.4.2",
		"vue-tsc": "^3.3.14"
	}
}
