{
	"name": "kuzix",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "npm run dev:server & npm run dev:front",
		"dev:server": "tsx watch server/src/index.ts",
		"dev:front": "vite --config front/vite.config.ts",
		"build": "vite build --config front/vite.config.ts",
		"start": "NODE_ENV=production tsx server/src/index.ts",
		"typecheck": "tsc -p server/tsconfig.json && vue-tsc -p front/tsconfig.json",
		"test": "node --import tsx --test 'server/src/**/*.test.ts'"
	},
	"dependencies": {
		"express": "^5.3.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.23.1",
		"tsx": "^4.23.15",
		"vue": "^3.5.45",
		"vue-router": "^5.4.0",
		"ws": "^8.22.2"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/ws": "^8.18.2",
		"@vitejs/plugin-vue": "^6.0.10",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"vue-tsc": "^3.3.14"
	}
}
